<Project Sdk="Microsoft.NET.Sdk">

  <!-- net10.0 (not -windows) so Core tests run on any CI agent. Platform tests that need Windows
       will multi-target when they appear (M2). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Clicky.Core\Clicky.Core.csproj" />
    <!-- Launched by the connector tests as a real stdio MCP server. -->
    <ProjectReference Include="..\Clicky.TestMcpServer\Clicky.TestMcpServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- In-process streamable HTTP MCP server (with a fake OAuth server) for the connector tests. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
