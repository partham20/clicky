<Project Sdk="Microsoft.NET.Sdk">

  <!-- A tiny stdio MCP server for the connector tests, and for trying Settings › Connectors by hand
       without Node: dotnet Clicky.TestMcpServer.dll -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- It runs from the test output folder, where the test project's ASP.NET Core framework
         reference supplies Microsoft.Extensions.* instead of copied DLLs. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
