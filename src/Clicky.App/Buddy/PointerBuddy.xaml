<UserControl
    x:Class="Clicky.App.Buddy.PointerBuddy"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="64"
    Height="64"
    Focusable="False"
    IsHitTestVisible="False">
  <!--
    64x64 DIP box. The arrow tip sits at (24,24); its body centre is about (29.5,33), which the ring,
    glow and orbit are centred on. Colours match Assets/clicky.ico (#2563EB on white).
    Idle has no storyboard, so a still buddy costs no frames.
  -->
  <UserControl.RenderTransform>
    <TranslateTransform x:Name="Translate" />
  </UserControl.RenderTransform>

  <Canvas x:Name="LayoutRoot" Width="64" Height="64">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="Presence">
        <VisualStateGroup.Transitions>
          <VisualTransition GeneratedDuration="0:0:0.15" />
        </VisualStateGroup.Transitions>

        <VisualState x:Name="Idle" />

        <VisualState x:Name="Listening">
          <Storyboard RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:1.1" />
            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX" From="0.55" To="1.55" Duration="0:0:1.1">
              <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
              </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY" From="0.55" To="1.55" Duration="0:0:1.1">
              <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
              </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
          </Storyboard>
        </VisualState>

        <VisualState x:Name="Thinking">
          <Storyboard RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Orbit" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
            <DoubleAnimation Storyboard.TargetName="OrbitRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.2" />
          </Storyboard>
        </VisualState>

        <VisualState x:Name="Speaking">
          <Storyboard RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" From="0.35" To="0.9" Duration="0:0:0.45">
              <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseInOut" />
              </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ArrowScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.08" Duration="0:0:0.45" />
            <DoubleAnimation Storyboard.TargetName="ArrowScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.08" Duration="0:0:0.45" />
          </Storyboard>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <!-- Speaking: soft glow behind the arrow. -->
    <Ellipse
        x:Name="Glow"
        Canvas.Left="9.5"
        Canvas.Top="13"
        Width="40"
        Height="40"
        Opacity="0">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Offset="0" Color="#B32563EB" />
          <GradientStop Offset="1" Color="#002563EB" />
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <!-- Listening: a ring that pulses outward. -->
    <Ellipse
        x:Name="Ring"
        Canvas.Left="15.5"
        Canvas.Top="19"
        Width="28"
        Height="28"
        Opacity="0"
        RenderTransformOrigin="0.5,0.5"
        Stroke="#2563EB"
        StrokeThickness="2">
      <Ellipse.RenderTransform>
        <ScaleTransform x:Name="RingScale" />
      </Ellipse.RenderTransform>
    </Ellipse>

    <!-- Thinking: three dots orbiting the arrow. -->
    <Canvas
        x:Name="Orbit"
        Canvas.Left="9.5"
        Canvas.Top="13"
        Width="40"
        Height="40"
        Opacity="0"
        RenderTransformOrigin="0.5,0.5">
      <Canvas.RenderTransform>
        <RotateTransform x:Name="OrbitRotate" />
      </Canvas.RenderTransform>
      <Ellipse Canvas.Left="17" Canvas.Top="-1" Width="6" Height="6" Fill="#2563EB" />
      <Ellipse Canvas.Left="33.1" Canvas.Top="26.5" Width="5" Height="5" Fill="#2563EB" Opacity="0.7" />
      <Ellipse Canvas.Left="2.4" Canvas.Top="27" Width="4" Height="4" Fill="#2563EB" Opacity="0.45" />
    </Canvas>

    <!-- The pointer itself: same silhouette as the tray icon, white edge so it reads on any background. -->
    <Path
        x:Name="Arrow"
        Canvas.Left="24"
        Canvas.Top="24"
        Data="M0,0 L0,17 L4.6,12.8 L7.6,19.6 L10.4,18.4 L7.4,11.6 L13,11.6 Z"
        Fill="#2563EB"
        RenderTransformOrigin="0.3,0.45"
        Stroke="White"
        StrokeLineJoin="Round"
        StrokeThickness="1.5">
      <Path.RenderTransform>
        <ScaleTransform x:Name="ArrowScale" />
      </Path.RenderTransform>
      <Path.Effect>
        <DropShadowEffect BlurRadius="4" Opacity="0.35" ShadowDepth="1" Direction="300" />
      </Path.Effect>
    </Path>
  </Canvas>
</UserControl>
