<Window
    x:Class="Clicky.App.Views.PlaceholderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="480"
    Height="260"
    MinWidth="360"
    MinHeight="200"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen"
    Icon="pack://application:,,,/Assets/clicky.ico">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" />
    <TextBlock x:Name="Body" Grid.Row="1" Margin="0,12,0,0" TextWrapping="Wrap" />
    <Button
        x:Name="ActionButton"
        Grid.Row="2"
        MinWidth="140"
        Padding="12,4"
        HorizontalAlignment="Left"
        Click="OnActionClick"
        Visibility="Collapsed" />
  </Grid>
</Window>
