<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure .NET: no Windows APIs here so prompts/schema/agent loop can be shared and unit-tested anywhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Clicky.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <!-- The action schema and prompts ship inside the assembly; names are fixed so code can find them. -->
    <EmbeddedResource Include="Actions/actions.schema.json" LogicalName="Clicky.Core.Actions.actions.schema.json" />
    <EmbeddedResource Include="Prompts/*.md" LogicalName="Clicky.Core.Prompts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Clicky.Tests" />
  </ItemGroup>

</Project>
